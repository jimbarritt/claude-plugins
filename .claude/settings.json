{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tsk thread session-start --install-plugin claude-cli"
          },
          {
            "type": "command",
            "command": "claude plugin install swe@jimbarritt-claude-plugins --scope project >/dev/null 2>&1 || true"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "tsk@jimbarritt-claude-plugins": true,
    "swe@jimbarritt-claude-plugins": true
  },
  "extraKnownMarketplaces": {
    "jimbarritt-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "jimbarritt/claude-plugins"
      }
    }
  }
}
