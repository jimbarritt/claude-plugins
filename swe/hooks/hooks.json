{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/bash-check.sh\""
          }
        ]
      },
      {
        "matcher": "Artifact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/artifact-check.sh\""
          }
        ]
      },
      {
        "matcher": "mcp__claude_ai_Gmail__.*|mcp__claude_ai_Google_Drive__.*|mcp__claude_ai_Slack__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/mcp-send-check.sh\""
          }
        ]
      }
    ]
  }
}
